# HyperBot M7-Ops is public-only and disabled until an operator opts in.
HYPERBOT_COLLECTOR_ENABLED=false
HYPERBOT_LIVE_ENABLED=false
HYPERBOT_SHADOW_ONLY=true

# Strict, manually reviewed whitelist. Never auto-promote catalog discoveries.
HYPERBOT_COLLECTOR_MARKETS=BTC
HYPERBOT_COLLECTOR_CHANNELS=l2Book,bbo,trades

# Container paths. Server bind mounts remain isolated from /opt/trident.
HYPERBOT_HOST_SHARED_DIR=/opt/hyperbot/shared
HYPERBOT_DATA_ROOT=/app/data/raw/collector
HYPERBOT_RUNTIME_ROOT=/app/runtime
HYPERBOT_REVIEW_ROOT=/app/data/reviews

# Collector reliability and bounded backpressure.
HYPERBOT_QUEUE_CAPACITY=10000
HYPERBOT_HEARTBEAT_INTERVAL_SECONDS=20
HYPERBOT_STALE_AFTER_SECONDS=60
HYPERBOT_RECONNECT_INITIAL_SECONDS=0.25
HYPERBOT_RECONNECT_MAX_SECONDS=15
HYPERBOT_STATUS_INTERVAL_SECONDS=10

# Docker health and conservative storage policy.
HYPERBOT_HEALTH_MAX_AGE_SECONDS=90
HYPERBOT_MINIMUM_FREE_BYTES=10737418240
HYPERBOT_MINIMUM_RETENTION_DAYS=60
HYPERBOT_MAINTENANCE_HOUR_UTC=0
HYPERBOT_MAINTENANCE_MINUTE_UTC=15
HYPERBOT_MAINTENANCE_POLL_SECONDS=60

# Optional HTTPS webhook is stored in this separate mode-600 file.
HYPERBOT_ALERT_WEBHOOK_FILE=/opt/hyperbot/shared/alert_webhook_url
HYPERBOT_WATCHDOG_INTERVAL_SECONDS=30
HYPERBOT_WATCHDOG_START_GRACE_SECONDS=120
HYPERBOT_ALERT_COOLDOWN_SECONDS=900

# Match the non-root deployment account on the server.
HYPERBOT_UID=1000
HYPERBOT_GID=1000
HYPERBOT_COLLECTOR_CPUS=1.0
HYPERBOT_COLLECTOR_MEMORY=768m
HYPERBOT_MAINTENANCE_CPUS=0.5
HYPERBOT_MAINTENANCE_MEMORY=512m
HYPERBOT_WATCHDOG_CPUS=0.25
HYPERBOT_WATCHDOG_MEMORY=128m
